# ---------------------------------------------------------------------------
# Copy to .env and adjust. docker-compose reads this file directly.
# ---------------------------------------------------------------------------

# --- Application connection strings -----------------------------------------
# Service hostnames (postgres, rabbitmq) match the docker-compose service names.
# Use the asyncpg driver so SQLAlchemy 2.0 async engine can connect.
DATABASE_URL=postgresql+asyncpg://payment:payment@postgres:5432/payment
RABBITMQ_URL=amqp://payment:payment@rabbitmq:5672/

# --- API auth ---------------------------------------------------------------
# Static key required in the X-API-Key header. Generate a strong value for prod,
# e.g. `openssl rand -hex 32`.
API_KEY=change-me-in-production

# --- PostgreSQL (consumed by the postgres image + DATABASE_URL above) --------
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
POSTGRES_DB=payment

# --- RabbitMQ (consumed by the rabbitmq image + RABBITMQ_URL above) ----------
RABBITMQ_DEFAULT_USER=payment
RABBITMQ_DEFAULT_PASS=payment

# --- Outbox poller ----------------------------------------------------------
# Seconds between polls of the outbox table for unpublished events.
OUTBOX_POLL_INTERVAL=2.0

# --- Webhook delivery -------------------------------------------------------
# Max delivery attempts before a webhook is given up on (exponential backoff).
WEBHOOK_MAX_RETRIES=3

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
